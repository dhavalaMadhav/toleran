# Engineering Drawing Intelligence & Design Compliance Copilot Configuration

# Environment
APP_ENV=development
APP_NAME="Engineering Drawing Intelligence & Design Compliance Copilot"
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Database
# Use SQLite for lightweight local dev or postgresql+psycopg2://user:password@localhost:5432/engdrawing for production
DATABASE_URL=sqlite:///./data/eng_drawing.db

# Storage
STORAGE_DIR=./data/storage
MAX_UPLOAD_SIZE_MB=50

# Security
SECRET_KEY=engineering_drawing_secret_key_change_in_production_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OCR Settings
OCR_ENGINE=rapidocr
OCR_CONFIDENCE_THRESHOLD=0.60

# AI / Vision-Language Model Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=
VLM_ENABLED=false
VLM_CONFIDENCE_THRESHOLD=0.75

# Retrieval / Vector Store
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Review Rules
AUTO_APPROVE_CONFIDENCE_THRESHOLD=0.90
REQUIRE_REVIEW_ON_AMBIGUOUS_FEATURE=true
